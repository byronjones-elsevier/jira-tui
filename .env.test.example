# .env.test.example
# Copy to .env.test and fill in your values before running run_vhs_tests.sh.
# .env.test is gitignored — never commit real credentials.

JIRA_BASE_URL="https://yourorg.atlassian.net"
JIRA_EMAIL="you@example.com"
JIRA_API_TOKEN="your-atlassian-api-token"

# A real project key in the instance above.
# The script will create test tickets in this project (prefixed "[VHS …]").
TEST_PROJECT_KEY="PROJ"

# A real Epic key in TEST_PROJECT_KEY that has child issues.
# Used to test the --create-csv-from-epic flow.
TEST_EPIC_KEY="PROJ-1"
